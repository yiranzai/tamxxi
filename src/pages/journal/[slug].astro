---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { url } from "../../lib/paths";
import { asset } from "../../react/data/assets";

export async function getStaticPaths() {
  const entries = await getCollection("journal");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const link = url;

const labels: Record<string, string> = {
  about: "关于",
  notes: "手记",
  process: "过程",
  exhibition: "展览",
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(date);
---

<Base title={entry.data.title} description={entry.data.description}>
  <SiteHeader variant="inset" active={entry.data.category === "about" ? "about" : "journal"} />
  <main class="article-page">
    <article class="article-inner">
      <a class="article-back" href={link("journal/")}>← Journal</a>
      <header class="article-head">
        <p class="work-card__cat">{labels[entry.data.category] ?? entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        <p class="article-desc">{entry.data.description}</p>
        <div class="article-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <div class="work-tags">
            {entry.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </header>

      {entry.data.cover && (
        <figure class="article-hero">
          <img
            src={asset(entry.data.cover)}
            alt={entry.data.coverAlt || entry.data.title}
          />
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      <footer class="article-foot">
        <a href={link("journal/")}>← Back to journal</a>
        <a href={link("works/")}>See the works →</a>
      </footer>
    </article>
  </main>
</Base>
